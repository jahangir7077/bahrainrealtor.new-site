---
import PropertyStatus from './PropertyStatus.astro';
import Card from './ui/Card.astro';
import { translate } from '../i18n/translate.ts';
import { formatCurrency, formatPropertyNumber } from '../i18n/formatting.ts';
import { getPublicationEligibility } from '../i18n/publication.ts';
import type { Language } from '../i18n/config.ts';
import type { PropertyRecord } from '../types/content.ts';

interface Props {
  property: PropertyRecord;
  language: Language;
}

const { property, language } = Astro.props;
const content = property.content[language];
const publication = property.publication[language];
const eligible = Boolean(publication && getPublicationEligibility(publication, language).routeAvailable);
const cover = property.images.find((image) => image.isCover);
const coverAlt = cover?.alt[language];
const price = property.priceBhd ? formatCurrency(property.priceBhd, language) : null;
---

<Card variant="white" bordered>
  {content && eligible ? (
    <article class="property-card" lang={language} dir={language === 'ar' ? 'rtl' : 'ltr'}>
      {cover && coverAlt && (
        <img
          class="property-card__image"
          src={cover.src}
          alt={coverAlt}
          width={cover.width}
          height={cover.height}
          loading="lazy"
        />
      )}
      <div class="property-card__body">
        <PropertyStatus language={language} status={property.availability} />
        <>
          <h3>{content.title}</h3>
          <p>{content.areaName}</p>
        </>
        {price && <p class="property-card__price" dir="ltr"><bdi>{price}</bdi></p>}
        <div class="property-card__facts">
          {property.bedrooms !== undefined && <span><bdi dir="ltr">{formatPropertyNumber(property.bedrooms, language, 0)}</bdi> {translate(language, 'vocabulary.bedrooms')}</span>}
          {property.bathrooms !== undefined && <span><bdi dir="ltr">{formatPropertyNumber(property.bathrooms, language, 0)}</bdi> {translate(language, 'vocabulary.bathrooms')}</span>}
          {property.sizeSquareMeters !== undefined && <span><bdi dir="ltr">{formatPropertyNumber(property.sizeSquareMeters, language)}</bdi> m²</span>}
        </div>
        <p class="property-card__reference">
          {translate(language, 'vocabulary.property')}:
          <bdi dir="ltr">{property.immutableReference}</bdi>
        </p>
      </div>
    </article>
  ) : (
    <p role="status">{translate(language, 'content.listingNotFound')}</p>
  )}
</Card>

<style>
  .property-card {
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .property-card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .property-card__body {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-family: var(--font-display);
  }

  .property-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .property-card__price {
    color: var(--color-navy);
    font-weight: 700;
  }

  .property-card__reference {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--type-small);
  }
</style>
