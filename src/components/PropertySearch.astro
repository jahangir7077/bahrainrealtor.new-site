---
import { translate } from '../i18n/translate.ts';
import type { Language } from '../i18n/config.ts';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const areas = [
  ['amwaj', 'areas.amwaj'],
  ['tala', 'areas.tala'],
  ['marassi', 'areas.marassi'],
  ['diyar', 'areas.diyar'],
  ['dilmunia', 'areas.dilmunia'],
  ['manama', 'areas.manama'],
] as const;
const types = [
  'apartments',
  'villas',
  'houses',
  'land',
  'buildings',
  'commercial',
  'freehold',
] as const;
---

<section class="search-panel" aria-labelledby={`search-title-${language}`} lang={language} dir={language === 'ar' ? 'rtl' : 'ltr'}>
  <div class="search-panel__heading">
    <h2 id={`search-title-${language}`}>{translate(language, 'search.title')}</h2>
    <p id={`search-status-${language}`}>{translate(language, 'search.pending')}</p>
  </div>
  <fieldset disabled aria-describedby={`search-status-${language}`}>
    <legend>{translate(language, 'search.title')}</legend>
    <label>
      {translate(language, 'search.transaction')}
      <select>
        <option>{translate(language, 'search.buy')}</option>
        <option>{translate(language, 'search.rent')}</option>
      </select>
    </label>
    <label>
      {translate(language, 'search.location')}
      <select>
        <option>{translate(language, 'search.chooseLocation')}</option>
        {areas.map(([key, translationKey]) => <option value={key}>{translate(language, translationKey)}</option>)}
      </select>
    </label>
    <label>
      {translate(language, 'search.propertyType')}
      <select>
        <option>{translate(language, 'search.chooseType')}</option>
        {types.map((type) => <option value={type}>{translate(language, `categories.${type}`)}</option>)}
      </select>
    </label>
    <label>
      {translate(language, 'search.minimumPrice')}
      <input type="number" inputmode="numeric" min="0" />
    </label>
    <label>
      {translate(language, 'search.maximumPrice')}
      <input type="number" inputmode="numeric" min="0" />
    </label>
    <label>
      {translate(language, 'search.bedrooms')}
      <select><option>{translate(language, 'search.anyBedrooms')}</option></select>
    </label>
    <button type="button" disabled>{translate(language, 'search.search')}</button>
  </fieldset>
</section>

<style>
  .search-panel {
    padding: clamp(var(--space-5), 4vw, var(--space-8));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text-primary);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .search-panel__heading h2 {
    margin-block: 0 var(--space-2);
    font-family: var(--font-display);
  }

  .search-panel__heading p {
    color: var(--color-text-secondary);
  }

  fieldset {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    align-items: end;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  label {
    display: grid;
    gap: var(--space-2);
    font-size: var(--type-small);
    font-weight: 700;
  }

  input,
  select {
    width: 100%;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-button);
    background: var(--color-surface);
  }

  button {
    min-height: var(--target-min);
    padding-inline: var(--space-4);
    border: 0;
    border-radius: var(--radius-button);
    color: var(--color-white);
    background: var(--color-navy);
    font-weight: 700;
  }

  :disabled {
    cursor: not-allowed;
    opacity: 0.72;
  }
</style>
