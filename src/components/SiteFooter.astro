---
import Container from './ui/Container.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { translate } from '../i18n/translate.ts';
import type { Language } from '../i18n/config.ts';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const home = language === 'ar' ? '/ar/' : '/';
const anchor = (id: string) => `${home}#${id}`;
---

<footer class="site-footer" lang={language} dir={language === 'ar' ? 'rtl' : 'ltr'}>
  <Container width="wide">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={home} class="site-footer__wordmark">Bahrain Realtor</a>
        <p>{translate(language, 'home.introduction')}</p>
        <LanguageSwitcher language={language} />
      </div>
      <nav aria-label={translate(language, 'navigation.propertyTypes')}>
        <h2>{translate(language, 'navigation.buyRent')}</h2>
        <ul>
          <li><a href={anchor('property-types')}>{translate(language, 'navigation.propertyTypes')}</a></li>
          <li><a href={anchor('areas')}>{translate(language, 'navigation.areas')}</a></li>
          <li><a href={anchor('projects')}>{translate(language, 'navigation.projects')}</a></li>
        </ul>
      </nav>
      <nav aria-label={translate(language, 'navigation.insights')}>
        <h2>{translate(language, 'navigation.insights')}</h2>
        <ul>
          <li><a href={anchor('insights')}>{translate(language, 'navigation.blog')}</a></li>
          <li><a href={anchor('investment')}>{translate(language, 'navigation.investment')}</a></li>
          <li><a href={anchor('financing')}>{translate(language, 'navigation.financing')}</a></li>
        </ul>
      </nav>
      <div>
        <h2>{translate(language, 'navigation.contact')}</h2>
        <p>{translate(language, 'content.contactPending')}</p>
        <a href={anchor('contact')}>{translate(language, 'navigation.contactAdvisor')}</a>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} Bahrain Realtor</span>
      <span>{translate(language, 'development.banner')}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-12) var(--space-5);
    color: var(--color-text-on-dark);
    background: var(--color-navy);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-8);
    padding-block-end: var(--space-10);
  }

  .site-footer h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-gold);
    font-family: var(--font-body);
    font-size: var(--type-body);
  }

  .site-footer p {
    max-width: 32ch;
    color: #e2e8f0;
  }

  .site-footer ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__wordmark {
    display: inline-block;
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--type-h3);
    text-decoration: none;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid rgb(255 255 255 / 28%);
    color: #e2e8f0;
    font-size: var(--type-small);
  }
</style>
