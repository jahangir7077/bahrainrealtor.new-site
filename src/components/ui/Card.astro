---
type Variant = 'white' | 'ivory' | 'dark';
type Padding = 'small' | 'medium' | 'large';

interface Props {
  variant?: Variant;
  padding?: Padding;
  bordered?: boolean;
}

const { variant = 'white', padding = 'medium', bordered = false } = Astro.props;
---

<article class:list={['card', `card--${variant}`, `card--padding-${padding}`, { 'card--bordered': bordered }]}>
  <slot />
</article>

<style>
  .card {
    min-width: 0;
    border-radius: var(--radius-card);
  }

  .card--white {
    color: var(--color-text-primary);
    background: var(--color-surface);
  }

  .card--ivory {
    color: var(--color-text-primary);
    background: var(--color-surface-subtle);
  }

  .card--dark {
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
  }

  .card--bordered {
    border: 1px solid var(--color-border-interactive);
  }

  .card:not(.card--bordered) {
    box-shadow: var(--shadow-card);
  }

  .card--padding-small {
    padding: var(--space-4);
  }

  .card--padding-medium {
    padding: var(--space-6);
  }

  .card--padding-large {
    padding: clamp(var(--space-6), 4vw, var(--space-10));
  }
</style>
