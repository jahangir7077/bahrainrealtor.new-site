---
type Level = 1 | 2 | 3 | 4 | 5 | 6;
type Alignment = 'start' | 'center';
interface Props {
  level?: Level;
  eyebrow?: string;
  description?: string;
  alignment?: Alignment;
}
const { level = 2, eyebrow, description, alignment = 'start' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${alignment}`]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  {level === 1 && <h1 class="section-heading__title"><slot /></h1>}
  {level === 2 && <h2 class="section-heading__title"><slot /></h2>}
  {level === 3 && <h3 class="section-heading__title"><slot /></h3>}
  {level === 4 && <h4 class="section-heading__title"><slot /></h4>}
  {level === 5 && <h5 class="section-heading__title"><slot /></h5>}
  {level === 6 && <h6 class="section-heading__title"><slot /></h6>}
  {description && <p class="section-heading__description">{description}</p>}
</div>

<style>
  .section-heading {
    max-width: var(--content-narrow);
    margin-block-end: var(--space-8);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading__eyebrow {
    margin-block-end: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--type-small);
    font-weight: 700;
  }

  .section-heading__title {
    margin-block-end: var(--space-3);
  }

  .section-heading__description {
    margin: 0;
    color: var(--color-text-secondary);
  }
</style>
