---
import '../styles/global.css';
import { localeConfig } from '../i18n/config';
import { translate } from '../i18n/translate.ts';
import SEOHead from '../components/SEOHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { directionFor } from '../utils/site';
import type { HreflangLink } from '../utils/seo/hreflang.ts';
import type { Language } from '../types/site';

interface Props {
  title: string;
  description: string;
  language: Language;
  showChrome?: boolean;
  indexingEligible?: boolean;
  enableCanonical?: boolean;
  showOpenGraph?: boolean;
  alternates?: readonly HreflangLink[];
}

const {
  title,
  description,
  language,
  showChrome = true,
  indexingEligible = false,
  enableCanonical = false,
  showOpenGraph = false,
  alternates = [],
} = Astro.props;

const siteLocale = (value: Language) => localeConfig[value].language;
---

<!doctype html>
<html lang={siteLocale(language)} dir={directionFor(language)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title={title}
      description={description}
      language={language}
      pathname={Astro.url.pathname}
      indexingEligible={indexingEligible}
      enableCanonical={enableCanonical}
      showOpenGraph={showOpenGraph}
      alternates={alternates}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{translate(language, 'accessibility.skipToContent')}</a>
    {showChrome && <SiteHeader language={language} />}
    <main id="main-content">
      <slot />
    </main>
    {showChrome && <SiteFooter language={language} />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 20;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    transform: translateY(-160%);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-button);
    color: var(--color-white);
    background: var(--color-navy);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
