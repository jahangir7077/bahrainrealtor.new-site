---
import FaqTemplate from '../../../../components/templates/FaqTemplate.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { translate } from '../../../../i18n/translate.ts';
import {
  editorialArchiveAlternates,
  listPublishedFaqs,
} from '../../../../server/editorial/repository.ts';
import { getPublicationEligibility } from '../../../../i18n/publication.ts';

let faqs: Awaited<ReturnType<typeof listPublishedFaqs>> = [];
let equivalentFaqs: Awaited<ReturnType<typeof listPublishedFaqs>> = [];
let unavailable = false;
try {
  faqs = await listPublishedFaqs('ar');
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const indexable = process.env.SEO_INDEXING_ENABLED === 'true' &&
  faqs.some((faq) => {
    const publication = faq.publication.ar;
    return Boolean(publication && getPublicationEligibility(publication, 'ar').routeAvailable);
  });
if (indexable) {
  try {
    equivalentFaqs = await listPublishedFaqs('en');
  } catch {
    equivalentFaqs = [];
  }
}
const alternates = editorialArchiveAlternates(equivalentFaqs, faqs, '/blog/faqs/');
if (!indexable) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<BaseLayout
  title={translate('ar', 'home.faqTitle')}
  description={translate('ar', 'home.faqDescription')}
  language="ar"
  indexingEligible={indexable}
  enableCanonical={indexable}
  showOpenGraph
  alternates={alternates}
>
  <FaqTemplate language="ar" faqs={faqs} preview={false} unavailable={unavailable} />
</BaseLayout>
