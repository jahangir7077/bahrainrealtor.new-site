---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorialHub from '../../../components/EditorialHub.astro';
import { getPublicationEligibility } from '../../../i18n/publication.ts';
import { listPublishedArticles, listPublishedFaqs } from '../../../server/editorial/repository.ts';

let articles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
let faqs: Awaited<ReturnType<typeof listPublishedFaqs>> = [];
try {
  [articles, faqs] = await Promise.all([listPublishedArticles('ar'), listPublishedFaqs('ar')]);
} catch {
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const hasPublishedContent = articles.some((article) => {
  const publication = article.publication.ar;
  return Boolean(publication && getPublicationEligibility(publication, 'ar').routeAvailable);
}) || faqs.some((faq) => {
  const publication = faq.publication.ar;
  return Boolean(publication && getPublicationEligibility(publication, 'ar').routeAvailable);
});
const indexable = process.env.SEO_INDEXING_ENABLED === 'true' && hasPublishedContent;
if (!indexable) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<BaseLayout
  title="المدونة"
  description="مقالات عقارية منشورة وإجابات تمت مراجعتها."
  language="ar"
  indexingEligible={indexable}
  enableCanonical={indexable}
  showOpenGraph
>
  <EditorialHub language="ar" articleCount={articles.length} faqCount={faqs.length} />
</BaseLayout>
