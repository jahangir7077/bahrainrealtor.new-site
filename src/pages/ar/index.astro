---
import DevelopmentNotice from '../../components/DevelopmentNotice.astro';
import Card from '../../components/ui/Card.astro';
import Container from '../../components/ui/Container.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title={`${site.name} — صفحة تطويرية`} description="صفحة تطويرية مؤقتة." language="ar">
  <Container width="narrow" class="foundation-page">
    <Card variant="ivory">
      <h1 dir="ltr">{site.name}</h1>
      <DevelopmentNotice language="ar" />
    </Card>
  </Container>
</BaseLayout>

<style>
  .foundation-page {
    padding-block: clamp(var(--space-10), 12vw, var(--space-24));
  }
</style>
