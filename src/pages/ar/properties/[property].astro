---
import Detail from '../../../server/properties/Detail.astro';
import { getProperty, parsePropertyPath, propertyPath } from '../../../server/properties/repository.ts';

const path = parsePropertyPath(Astro.params.property);
let property: Awaited<ReturnType<typeof getProperty>> = null;
let unavailable = false;
if (!path || ![propertyPath(path, 'ar'), propertyPath(path, 'ar').slice(0, -1)].includes(Astro.url.pathname)) {
  Astro.response.status = 404;
} else {
  try {
    property = await getProperty('ar', path);
    if (!property) Astro.response.status = 404;
  } catch { unavailable = true; Astro.response.status = 503; }
}
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Detail language="ar" property={property} unavailable={unavailable} />
