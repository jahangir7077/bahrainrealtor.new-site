---
import ArticleArchive from '../../../components/ArticleArchive.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { translate } from '../../../i18n/translate.ts';
import { listPublishedArticles } from '../../../server/editorial/repository.ts';

let articles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
let unavailable = false;
try {
  articles = await listPublishedArticles('en');
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<BaseLayout title={translate('en', 'navigation.blog')} description={translate('en', 'home.insightsDescription')} language="en">
  <ArticleArchive language="en" articles={articles} unavailable={unavailable} />
</BaseLayout>
