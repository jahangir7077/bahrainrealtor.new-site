---
import ArticleArchive from '../../../components/ArticleArchive.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { translate } from '../../../i18n/translate.ts';
import { listPublishedArticles } from '../../../server/editorial/repository.ts';
import { getPublicationEligibility } from '../../../i18n/publication.ts';

let articles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
let unavailable = false;
try {
  articles = await listPublishedArticles('en');
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const indexable = process.env.SEO_INDEXING_ENABLED === 'true' &&
  articles.some((article) => {
    const publication = article.publication.en;
    return Boolean(publication && getPublicationEligibility(publication, 'en').routeAvailable);
  });
if (!indexable) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<BaseLayout
  title={translate('en', 'navigation.blog')}
  description={translate('en', 'home.insightsDescription')}
  language="en"
  indexingEligible={indexable}
  enableCanonical={indexable}
  showOpenGraph
>
  <ArticleArchive language="en" articles={articles} unavailable={unavailable} />
</BaseLayout>
