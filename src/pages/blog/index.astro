---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialHub from '../../components/EditorialHub.astro';
import { getPublicationEligibility } from '../../i18n/publication.ts';
import {
  editorialArchiveAlternates,
  listPublishedArticles,
  listPublishedFaqs,
} from '../../server/editorial/repository.ts';

let articles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
let faqs: Awaited<ReturnType<typeof listPublishedFaqs>> = [];
let equivalentArticles: Awaited<ReturnType<typeof listPublishedArticles>> = [];
let equivalentFaqs: Awaited<ReturnType<typeof listPublishedFaqs>> = [];
try {
  [articles, faqs] = await Promise.all([listPublishedArticles('en'), listPublishedFaqs('en')]);
} catch {
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const hasPublishedContent = articles.some((article) => {
  const publication = article.publication.en;
  return Boolean(publication && getPublicationEligibility(publication, 'en').routeAvailable);
}) || faqs.some((faq) => {
  const publication = faq.publication.en;
  return Boolean(publication && getPublicationEligibility(publication, 'en').routeAvailable);
});
const indexable = process.env.SEO_INDEXING_ENABLED === 'true' && hasPublishedContent;
if (indexable) {
  try {
    [equivalentArticles, equivalentFaqs] = await Promise.all([
      listPublishedArticles('ar'),
      listPublishedFaqs('ar'),
    ]);
  } catch {
    equivalentArticles = [];
    equivalentFaqs = [];
  }
}
const alternates = editorialArchiveAlternates(
  [...articles, ...faqs],
  [...equivalentArticles, ...equivalentFaqs],
  '/blog/',
);
if (!indexable) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<BaseLayout
  title="Blog"
  description="Published property articles and reviewed answers."
  language="en"
  indexingEligible={indexable}
  enableCanonical={indexable}
  showOpenGraph
  alternates={alternates}
>
  <EditorialHub language="en" articleCount={articles.length} faqCount={faqs.length} />
</BaseLayout>
