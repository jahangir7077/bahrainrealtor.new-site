---
import DevelopmentNotice from '../components/DevelopmentNotice.astro';
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`${site.name} — Development`} description="Development placeholder." language="en">
  <Container width="narrow" class="foundation-page">
    <Card variant="ivory">
      <h1>{site.name}</h1>
      <DevelopmentNotice language="en" />
    </Card>
  </Container>
</BaseLayout>

<style>
  .foundation-page {
    padding-block: clamp(var(--space-10), 12vw, var(--space-24));
  }
</style>
